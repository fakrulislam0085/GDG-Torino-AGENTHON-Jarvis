GOOGLE_CLOUD_PROJECT=token-mafia-agenthon
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash
# Which company the app runs on: a data folder inside jarvis-your-company-brain (data_filare = Filare Labs, the default).
JARVIS_DATA=data_filare
# Never ring a real phone by itself (1 = Jarvis may dial the CEO on an urgent email; only with Gemini + phone set up).
JARVIS_AUTO_DIAL=0
# Optional: the name Jarvis says on the phone (default: the CEO's first name from company.json).
# JARVIS_CALL_NAME=
# Minutes between automatic morning sweeps while the app is open (0 = off).
JARVIS_SWEEP_MINUTES=30
# Paste your ElevenLabs API key after the = sign (this file is git-ignored):
ELEVENLABS_API_KEY=
# Daniel: deep, authoritative British male (premade voice)
ELEVENLABS_VOICE_ID=onwK4e9ZLuTAKqWW03F9
