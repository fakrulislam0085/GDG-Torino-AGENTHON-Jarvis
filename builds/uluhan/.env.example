# Copy to builds/uluhan/.env (git-ignored) and fill in. Never commit the real file.

# Gemini on Vertex AI (event credits). gemini-3.8-flash is NOT served in europe-west1 (404); the "eu" multi-region works. Option A: user credentials via `gcloud auth application-default login`
GOOGLE_CLOUD_PROJECT=token-mafia-agenthon
GOOGLE_CLOUD_LOCATION=eu
GEMINI_MODEL=gemini-3.8-flash
# Option B instead of A: a Vertex AI API key
# GOOGLE_API_KEY=
# GOOGLE_GENAI_USE_VERTEXAI=true

# ElevenLabs voice brief (create the key in your ElevenLabs account settings)
ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=      # optional; default is the first voice on the account
# ELEVENLABS_MODEL=eleven_flash_v2_5

# Force the deterministic fallback (e.g. no Wi-Fi on stage)
# BRAIN_MODE=offline
